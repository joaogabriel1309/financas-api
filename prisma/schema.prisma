// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int              @id @default(autoincrement())
  nome            String
  login           String           @unique
  senha           String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  refreshTokens   RefreshToken[]
  contas          Conta[]
  formasPagamento FormaPagamento[]

  @@map("usuarios")
}

model Conta {
  id                String          @id @default(uuid()) @map("id")
  nome              String
  valor             Decimal         @default(0) @map("valor") @db.Decimal(15, 2)
  pago              Boolean         @default(false) @map("pago")
  recorrencia       Boolean         @default(false) @map("recorrencia")
  parcela           Int             @default(1) @map("parcela")
  mesReferencia     String          @map("mes_referencia") @db.VarChar(7)
  mesFim            String?         @map("mes_fim") @db.VarChar(7)
  dataHoraPagamento DateTime?       @map("data_hora_pagamento")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  usuarioId         Int             @map("usuario_id")
  usuario           Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  formaPagamento    FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  formaPagamentoId  String?
  pagamentos        ContaPagamento[]

  @@index([formaPagamentoId])
  @@index([usuarioId])
  @@index([usuarioId, mesReferencia, mesFim])
  @@map("contas")
}

model ContaPagamento {
  contaId           String   @map("conta_id")
  mes               String   @db.VarChar(7)
  dataHoraPagamento DateTime @default(now()) @map("data_hora_pagamento")
  conta             Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@id([contaId, mes])
  @@map("conta_pagamentos")
}

model FormaPagamento {
  id        String   @id @default(uuid()) @map("id")
  nome      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contas Conta[]

  @@unique([nome, usuarioId])
  @@map("formas_pagamento")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}
